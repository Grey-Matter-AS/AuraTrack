{
  "name": "auratrack",
  "private": true,
  "version": "7.0.7",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @auratrack/web dev",
    "build": "pnpm --filter @auratrack/web build && pnpm --filter @auratrack/server build",
    "preview": "pnpm --filter @auratrack/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "e2e:local": "playwright test --project=chromium --project=firefox --grep-invert \"layout audit|visual|kitchen sink\"",
    "mutation": "stryker run",
    "test:coverage": "vitest run --coverage",
    "icons": "node scripts/build-icons.mjs",
    "audit": "playwright test audit --project=chromium",
    "visual": "playwright test visual --project=chromium",
    "hub": "pnpm --filter @auratrack/server build && node apps/server/dist/hub.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "^4.10.2",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "peer": "^1.0.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
