{
  "name": "auratrack",
  "private": true,
  "version": "7.0.0-dev",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @auratrack/web dev",
    "build": "pnpm --filter @auratrack/web build",
    "preview": "pnpm --filter @auratrack/web preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-size.mjs",
    "e2e": "playwright test",
    "e2e:local": "playwright test --project=chromium --project=firefox"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
